# Telegram bot credentials (required)
API_ID=
API_HASH=
BOT_TOKEN=

# Owner and assistant sessions
OWNER_ID=
STRING_SESSION=
STRING_SESSION2=
STRING_SESSION3=
STRING_SESSION4=
STRING_SESSION5=

# MongoDB (optional; required for persistent /auth, sudo, block, welcome, playlist, stats)
MONGODB_URI=
DB_NAME=musicbot

# Initial admin IDs (optional, comma or space separated)
INITIAL_ADMIN_IDS=

# Media resolution
YTUBE_API_TOKEN=
YTUBE_API_BASE_URL=https://api.nubcoders.com
YOUTUBE_API_KEYS=
YT_COOKIES_FILE=

# Spotify source expansion (optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cookie handling for yt-dlp (age-restricted / region-locked videos)
YT_COOKIES_FILE=
COOKIES_FROM_BROWSER=
COOKIES_BOOTSTRAP_URL=
COOKIES_REFRESH_HOURS=

# Auto-leave idle assistant chats (prevents Telegram's 500-group limit)
AUTO_LEAVING_ASSISTANT=True
ASSISTANT_LEAVE_TIME=5400

# Support group username (without @)
GROUP=nub_coder_s

# Misc
LOG_LEVEL=info
MEDIA_RESOLVE_TIMEOUT=45
SHUTDOWN_TIMEOUT=15
ALLOW_PRIVATE_STREAM_URLS=false